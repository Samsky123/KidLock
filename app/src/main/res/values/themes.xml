<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 科技蓝 · 深色主题（不用 DayNight，避免浅色模式下深底浅字读不清） -->
    <style name="Theme.KidLock" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:windowFullscreen">true</item>

        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_deep</item>
        <item name="colorSecondary">@color/accent_2</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg_top</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
